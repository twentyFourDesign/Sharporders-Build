############################################
# Expo public environment (safe for client)
############################################

# Supabase project URL (from Supabase dashboard)
EXPO_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-NAME.supabase.co"

# Supabase anon public API key (never use the service_role key in the app)
EXPO_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_PUBLIC_KEY"

# Optional: environment label you can read in the app
# EXPO_PUBLIC_APP_ENV="development"


############################################
# Prisma / server-side tooling ONLY
# (do NOT load these in the Expo runtime)
############################################

# Postgres connection string for Supabase - fetch from "Connection string" in the dashboard.
# Use the "pooler" URL for DATABASE_URL.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres?pgbouncer=true&connection_limit=1"

# Use the "direct" URL for DIRECT_URL (used by Prisma migrations).
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_DIRECT_HOST:5432/postgres"

# Example: if you later add server-side functions or scripts, you can also keep secrets here, like:
# SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"


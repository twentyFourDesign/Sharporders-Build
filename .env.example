############################################
# Expo public environment (safe for client)
############################################

# Supabase project URL (from Supabase dashboard)
EXPO_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-NAME.supabase.co"

# Supabase anon public API key (never use the service_role key in the app)
EXPO_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_PUBLIC_KEY"

# Optional: environment label you can read in the app
# EXPO_PUBLIC_APP_ENV="development"


############################################
# Prisma / server-side tooling ONLY
# (do NOT load these in the Expo runtime)
############################################

EXPO_PUBLIC_BACKEND_URL="http://localhost:3000"


EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=""
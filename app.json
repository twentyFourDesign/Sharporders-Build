{
  "expo": {
    "name": "Sharporder",
    "slug": "sharporder-v2",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/new-icon.jpg",
    "scheme": "sharporderv2",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sharporder",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Sharporder uses your location to show nearby drivers, calculate delivery routes, and provide real-time tracking of your shipments. For example, your location helps match you with the closest available driver for faster pickup.",
        "NSCameraUsageDescription": "Sharporder uses your camera to allow you to take photos of packages or delivery items for shipment verification and tracking.",
        "NSPhotoLibraryUsageDescription": "Sharporder allows you to upload images from your photo library, such as package photos, to help manage and track deliveries."
      },
      "buildNumber": "13"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/new-icon.jpg",
        "monochromeImage": "./assets/new-icon.jpg"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sharporder",
      "versionCode": 4
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7bf5707e-1385-41c9-a824-8e3878b20708"
      }
    }
  }
}
